---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";

const faqs = [
  { q: "What is the best month to visit Dunhuang?", a: "May and September are the two best months: roughly 15-28C, clear skies, and moderate crowds. April, June and October are close behind. July and August are brutally hot (35-40C) and coincide with peak domestic tourism, so Mogao Caves tickets sell out weeks ahead." },
  { q: "How hot does it get in Dunhuang in summer?", a: "July and August regularly reach 35-40C in the afternoon, and the sand at Crescent Lake gets far hotter. It is manageable if you start at 7 AM, rest indoors through midday, and go out again from 5 PM. June and early September are much more comfortable." },
  { q: "What is Golden Week and should I avoid it?", a: "Golden Week is China's National Day holiday, 1-7 October. Attractions across the country fill with domestic tourists, hotel prices roughly double, and Mogao Caves tickets disappear. Visiting Dunhuang in the first week of October is possible but not recommended — the rest of October is excellent." },
  { q: "Is Dunhuang worth visiting in winter?", a: "Yes, if you can handle -10 to 5C. Attractions are nearly empty, hotels drop to roughly half price, Mogao Caves usually has same-week availability, and snow on the Singing Sand Dunes is genuinely spectacular for photography. The main trade-off is shortened daylight and some seasonal closures." },
];

const schema = {"@context":"https://schema.org","@graph":[{"@type":"Article","headline":"Best Time to Visit Dunhuang & Jiuquan 2026: Month by Month","description":"Month-by-month guide: weather, crowds, festival dates, and honest best seasons for the Silk Road. Plan around Golden Week, summer heat, and winter deals.","datePublished":"2026-07-01","dateModified":"2026-09-17"},{"@type":"FAQPage","mainEntity":faqs.map((f)=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))}]};

const seasons = [
  { name: "Spring", period: "March-May", temp: "5-28C", rating: "Best", desc: "March is cold with occasional sandstorms. April warms up with wildflowers. May is ideal: 15-28C, clear skies, moderate crowds. The best spring month." },
  { name: "Summer", period: "June-August", temp: "20-40C", rating: "Avoid if possible", desc: "June is still pleasant (20-30C). July and August are brutally hot (35-40C+), especially Dunhuang. Peak domestic tourism. Mogao Caves tickets sell out weeks ahead. Start activities by 7 AM and siesta midday." },
  { name: "Autumn", period: "September-October", temp: "5-25C", rating: "Best", desc: "September is magnificent: 15-25C, golden light, clear skies. October equally good but avoid the first week (Golden Week, Oct 1-7). Best season overall for comfortable temperatures and manageable crowds after Oct 7." },
  { name: "Winter", period: "November-February", temp: "-10 to 5C", rating: "Good for deals", desc: "Cold but sunny. Attractions nearly empty. Hotels half price. Mogao Caves often has availability. Snow on dunes is magical for photography. Avoid Chinese New Year week (dates vary)." }
];

const monthTable = [
  ["January", "-12 to 0", "Very low", "Cold, empty", "Good for deals"],
  ["February", "-8 to 5", "Low (except CNY)", "Cold snap", "Avoid CNY week"],
  ["March", "-3 to 12", "Low", "Sandstorm risk", "Acceptable"],
  ["April", "5 to 22", "Moderate", "Wildflowers bloom", "Good"],
  ["May", "10 to 28", "Moderate", "Ideal weather", "Excellent"],
  ["June", "16 to 32", "Moderate-high", "Warming up", "Very good"],
  ["July", "20 to 38", "Very high", "Peak heat", "Avoid"],
  ["August", "18 to 36", "Very high", "Peak heat", "Avoid"],
  ["September", "12 to 27", "Moderate", "Golden light", "Excellent"],
  ["October", "5 to 20", "High (Golden Week)", "Best season", "Excellent (after Oct 7)"],
  ["November", "-4 to 10", "Low", "Cool, quiet", "Very good"],
  ["December", "-10 to 2", "Very low", "Snow on dunes", "Good for deals"]
];
---

<BaseLayout title="Best Time to Visit Dunhuang &amp; Jiuquan 2026: Month by Month" description="When to visit Dunhuang and Jiuquan: monthly weather, crowd levels, festival dates, and honest best seasons. Avoid Golden Week and summer heat." author="Dunhuang &amp; Jiuquan Guide Team" datePublished="2026-07-01" dateModified="2026-09-17">
<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema)}></script></Fragment>

<div class="u-prose-wrap pb-20 md:pb-28">
  <header class="pt-12 md:pt-20 mb-16 reveal">
    <SectionHeader eyebrow="When to Go" title="Best Time to Visit Dunhuang &amp; Jiuquan" subtitle="Month-by-month weather, crowds, and honest advice on when to plan your Silk Road trip. Based on multiple visits across all seasons." />
  </header>

  <!-- Lead answer — direct response to search intent, rendered without reveal -->
  <p class="text-lg text-stone-700 leading-relaxed mb-10">
    The short answer: <strong class="text-stone-900">go in May or September</strong>. Both give 15-28C, clear desert skies and manageable crowds. <strong class="text-stone-900">Avoid July and August</strong> (35-40C plus peak domestic tourism) and <strong class="text-stone-900">avoid 1-7 October</strong>, when Golden Week roughly doubles hotel prices and clears out Mogao Caves tickets. Winter is cold but genuinely rewarding if you want the sites to yourself.
  </p>

      <!-- Placeholder image - replace with real photography -->
      <div class="u-figure">
        <img src="/images/best-time-to-visit.webp?v=2" alt="Best Time to Visit Dunhuang" class="u-img" width="1200" height="600" loading="lazy" />
      </div>

  <section class="mb-16 reveal">
    <div class="grid sm:grid-cols-3 gap-4 mb-10">
      <div class="bg-mogao-50 rounded-2xl p-6 text-center border border-mogao-200"><p class="text-3xl mb-2">&#x2600;</p><p class="font-semibold text-mogao-700">Best Overall</p><p class="mt-1 text-sm text-stone-600">May-June &amp; September-October</p></div>
      <div class="bg-amber-50 rounded-2xl p-6 text-center border border-amber-200"><p class="text-3xl mb-2">&#x26A0;</p><p class="font-semibold text-amber-700">Avoid</p><p class="mt-1 text-sm text-stone-600">Golden Week (Oct 1-7), CNY week</p></div>
      <div class="bg-stone-100 rounded-2xl p-6 text-center border border-stone-200"><p class="text-3xl mb-2">&#x1F4B0;</p><p class="font-semibold text-stone-700">Cheapest</p><p class="mt-1 text-sm text-stone-600">November-February (except CNY)</p></div>
    </div>
  </section>

  <section class="mb-16 reveal">
    <h2 class="text-2xl font-display u-strong mb-6">Season-by-Season</h2>
    <div class="space-y-4">
      {seasons.map(({ name, period, temp, rating, desc }) => (
        <div class="u-card">
          <div class="flex items-start justify-between gap-4"><div><h3 class="u-strong">{name} <span class="text-xs font-normal text-stone-500">({period}, {temp})</span></h3><p class="u-p2">{desc}</p></div><span class="shrink-0 rounded-full bg-mogao-50 px-3 py-1 text-xs font-semibold text-mogao-600">{rating}</span></div>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16 reveal">
    <h2 class="text-2xl font-display u-strong mb-6">Month-by-Month Breakdown</h2>
    <div class="rounded-xl border border-stone-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-stone-50 border-b border-stone-200">
          <tr><th class="text-left px-5 py-3 font-medium text-stone-700">Month</th><th class="text-center px-5 py-3 font-medium text-stone-700">Temp (C)</th><th class="text-center px-5 py-3 font-medium text-stone-700">Crowds</th><th class="text-left px-5 py-3 font-medium text-stone-700 hidden sm:table-cell">Conditions</th><th class="text-left px-5 py-3 font-medium text-stone-700 hidden sm:table-cell">Verdict</th></tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {monthTable.map((row) => (
            <tr class="hover:bg-stone-50"><td class="px-5 py-3 text-stone-700 font-medium">{row[0]}</td><td class="text-center px-5 py-3 text-stone-600">{row[1]}</td><td class="text-center px-5 py-3 text-stone-600">{row[2]}</td><td class="px-5 py-3 text-stone-500 hidden sm:table-cell">{row[3]}</td><td class="px-5 py-3 text-stone-500 hidden sm:table-cell">{row[4]}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- FAQ — visible content backing the FAQPage schema above -->
  <section class="mb-16">
    <h2 class="text-2xl font-display u-strong mb-6">Frequently Asked Questions</h2>
    <div class="space-y-3">
      {faqs.map((f) => (
        <details class="group bg-white rounded-2xl border border-stone-200">
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer text-left u-strong list-none">
            {f.q}
            <svg class="w-5 h-5 shrink-0 text-stone-500 group-open:rotate-180 transition-transform" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="px-6 pb-5 text-stone-600 text-sm leading-relaxed">{f.a}</div>
        </details>
      ))}
    </div>
  </section>

  <div class="u-cta-card reveal">
    <h3 class="text-xl font-display font-semibold">Pick your dates</h3>
    <p class="mt-2 text-mogao-100 text-sm">Use our itinerary planner to build a trip around your preferred season.</p>
    <a href="/itinerary/" class="u-btn-outline2">Browse Itineraries</a>
  </div>
</div>
</BaseLayout>

