---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";

const pageDescription = "Plan your Silk Road trip with expert Dunhuang and Jiuquan guides covering Mogao Caves, Crescent Lake, Jiayuguan Fort, trains, and 3/5/7-day itineraries.";

const orgSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "Dunhuang & Jiuquan Travel Guide 2026 | Complete Silk Road Planning",
      "description": "Honest, practical guide to Dunhuang and Jiuquan: Mogao Caves tickets, Jiayuguan Fort, Crescent Lake, transport, 3/5/7-day itineraries, budget breakdown, food, and insider tips from firsthand experience.",
      "author": { "@type": "Person", "name": "Dunhuang & Jiuquan Guide Team" },
      "datePublished": "2026-06-01",
      "image": "https://dunhuang-jiuquan.com/og-default.webp",
      "publisher": { "@type": "Organization", "name": "Dunhuang & Jiuquan Guide", "url": "https://dunhuang-jiuquan.com" },
      "mainEntityOfPage": { "@type": "WebPage", "@id": "https://dunhuang-jiuquan.com" },
      "datePublished": "2026-06-01",
      "dateModified": "2026-08-07"
    },
    {
      "@type": "TouristDestination",
      "name": "Dunhuang & Jiuquan Silk Road Corridor",
      "description": "Two historic Silk Road cities in Gansu Province: Dunhuang (Mogao Caves, Crescent Lake) and Jiuquan (Jiayuguan Fort, Satellite Launch Center). Connected by a 2.5-hour high-speed train across the Hexi Corridor.",
      "touristType": ["History Buffs", "Photographers", "Adventure Travelers", "Cultural Travelers"],
      "geo": { "@type": "GeoCoordinates", "latitude": 40.14, "longitude": 95.5 },
      "address": { "@type": "PostalAddress", "addressLocality": "Dunhuang & Jiuquan", "addressRegion": "Gansu", "addressCountry": "CN" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How many days do I need for Dunhuang and Jiuquan?", "acceptedAnswer": { "@type": "Answer", "text": "Minimum 4 days: 2-3 in Dunhuang (Mogao Caves, Crescent Lake, Yadan Geopark), 1-2 in Jiuquan (Jiayuguan Fort). With 7 days add Zhangye Rainbow Mountains. High-speed train between cities takes only 2.5 hours." } },
        { "@type": "Question", "name": "Dunhuang or Jiuquan - which one should I visit?", "acceptedAnswer": { "@type": "Answer", "text": "Dunhuang if you can only visit one - it is the cultural heart of the Silk Road with Mogao Caves and Crescent Lake. Jiuquan is essential for history buffs (Jiayuguan Fort, Great Wall terminus) and space enthusiasts (Satellite Launch Center). With 5+ days, visit both - the train takes only 2.5 hours." } },
        { "@type": "Question", "name": "How do I get from Dunhuang to Jiuquan?", "acceptedAnswer": { "@type": "Answer", "text": "High-speed train is the clear winner: 2.5 hours, CNY 150-200, 10+ departures daily. Long-distance bus (5-6 hours, CNY 60-80) is the budget option. Private car (4-5 hours, CNY 600-900) gives the most flexibility for photography stops." } },
        { "@type": "Question", "name": "When is the best time to visit?", "acceptedAnswer": { "@type": "Answer", "text": "May-June and September-October are ideal with mild temperatures (15-28C) and manageable crowds. Avoid July-August (35-40C desert heat, peak domestic tourism) and Chinese Golden Week (Oct 1-7). Winter (Nov-Feb) offers half-price hotels and near-empty attractions." } },
        { "@type": "Question", "name": "How much does a trip cost?", "acceptedAnswer": { "@type": "Answer", "text": "Budget CNY 500-1200 (USD 70-170) per person per day including accommodation, meals, transport, and attraction tickets. Mogao Caves A-ticket costs CNY 238-258. Crescent Lake CNY 120. Jiayuguan Fort combined ticket CNY 120. High-speed train between cities CNY 150-200." } },
        { "@type": "Question", "name": "Can I book Mogao Caves as a foreigner?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Use the official WeChat mini-program (Chinese phone number required), book through Trip.com (5-15% markup but international card accepted), or ask your hotel concierge. A-tickets (8 caves + 2 films) must be booked 1-4 weeks ahead in peak season (May-October). Passport required for entry." } },
        { "@type": "Question", "name": "Is Gansu safe for solo travelers?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, very safe. The Silk Road cities are well-policed and tourist-friendly. Violent crime is extremely rare. The main challenges are practical: language barrier outside major hotels, mobile payment setup (install Alipay before arriving), and extreme desert heat in summer." } }
      ]
    }
  ]
};
---

<BaseLayout
  title="Dunhuang &amp; Jiuquan Travel Guide 2026 — Silk Road Planning"
  description={pageDescription}
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
  </slot>

  <section class="relative overflow-hidden bg-gradient-to-b from-mogao-900 via-mogao-800 to-mogao-700">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-b from-mogao-950/30 via-transparent to-mogao-950/60 z-10" />
      <picture>
        <source srcset="/hero.webp" type="image/webp" />
        <img src="/hero.jpg" alt="Mogao Caves nine-story facade at golden hour with Gobi Desert stretching to the horizon" class="h-full w-full object-cover" width="1920" height="1249" loading="eager" decoding="sync" sizes="100vw" />
      </picture>
    </div>
    <div class="relative z-20 mx-auto max-w-7xl px-4 md:px-6 py-24 md:py-40">
      <div class="max-w-2xl">
        <div class="inline-flex items-center rounded-full border border-white/20 bg-white/10 backdrop-blur-sm px-3 py-1 text-xs font-medium text-white/90 mb-6">
          Independent guide &middot; No booking fees &middot; Updated August 2026
        </div>
        <h1 class="text-4xl md:text-6xl font-semibold tracking-tight text-white leading-tight">Dunhuang &amp; Jiuquan Silk Road Travel Guide</h1>
        <p class="mt-6 text-lg text-white/80 leading-relaxed max-w-xl">
          Two cities, one legendary corridor. Everything you need to plan your journey through China's ancient Silk Road &mdash; Mogao Caves, Jiayuguan Fort, Crescent Lake, and the Gobi Desert. Honest advice from people who have been there.
        </p>
        <p class="mt-3 text-sm text-white/60 max-w-xl">
          The high-speed train connects both cities in just <span class="text-mogao-300">2.5 hours</span>. Budget from <span class="text-mogao-300">CNY 500/day</span>.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/guide" class="inline-flex items-center gap-2 rounded-xl bg-mogao-500 px-5 py-3 text-sm font-semibold text-white transition-all hover:bg-mogao-600 active:scale-[0.98] shadow-lg shadow-mogao-900/30">
            Start Planning
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l5 5-5 5"/></svg>
          </a>
          <a href="#at-a-glance" class="inline-flex items-center gap-2 rounded-xl border border-white/30 bg-white/10 backdrop-blur-sm px-5 py-3 text-sm font-semibold text-white transition-all hover:bg-white/20 active:scale-[0.98]">
            Quick Overview
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v10M3 8h10"/></svg>
          </a>
        </div>
      </div>
      <p class="absolute bottom-3 right-4 md:right-6 z-30 text-[10px] text-white/40">Photo taken along the Hexi Corridor</p>
    </div>
  </section>

  <section class="bg-stone-900 text-white">
    <div class="mx-auto max-w-7xl px-4 md:px-6 py-12 md:py-16">
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4 md:gap-6">
        <div class="text-center"><p class="text-xs font-medium text-stone-400 uppercase tracking-wider mb-1">Chinese Name</p><p class="text-xl md:text-2xl font-semibold text-white">敦煌 &amp; 酒泉</p><p class="text-xs text-stone-500 mt-0.5">Dunhuang &amp; Jiuquan</p></div>
        <div class="text-center"><p class="text-xs font-medium text-stone-400 uppercase tracking-wider mb-1">Province</p><p class="text-xl md:text-2xl font-semibold text-white">Gansu</p><p class="text-xs text-stone-500 mt-0.5">Northwest China</p></div>
        <div class="text-center"><p class="text-xs font-medium text-stone-400 uppercase tracking-wider mb-1">UNESCO</p><p class="text-xl md:text-2xl font-semibold text-white">Mogao Caves</p><p class="text-xs text-stone-500 mt-0.5">Since 1987</p></div>
        <div class="text-center"><p class="text-xs font-medium text-stone-400 uppercase tracking-wider mb-1">Distance Apart</p><p class="text-xl md:text-2xl font-semibold text-white">400 km</p><p class="text-xs text-stone-500 mt-0.5">Hexi Corridor</p></div>
        <div class="text-center"><p class="text-xs font-medium text-stone-400 uppercase tracking-wider mb-1">High-Speed Train</p><p class="text-xl md:text-2xl font-semibold text-white">2.5 hours</p><p class="text-xs text-stone-500 mt-0.5">CNY 150-200</p></div>
        <div class="text-center"><p class="text-xs font-medium text-stone-400 uppercase tracking-wider mb-1">Best Season</p><p class="text-xl md:text-2xl font-semibold text-white">May-Jun, Sep-Oct</p><p class="text-xs text-stone-500 mt-0.5">15-28°C</p></div>
        <div class="text-center"><p class="text-xs font-medium text-stone-400 uppercase tracking-wider mb-1">Budget/Day</p><p class="text-xl md:text-2xl font-semibold text-white">CNY 500-1200</p><p class="text-xs text-stone-500 mt-0.5">USD 70-170</p></div>
        <div class="text-center"><p class="text-xs font-medium text-stone-400 uppercase tracking-wider mb-1">Recommended</p><p class="text-xl md:text-2xl font-semibold text-white">4-7 days</p><p class="text-xs text-stone-500 mt-0.5">For full experience</p></div>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 md:px-6 pt-8 pb-20 md:pb-28">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-stone-900">What Are Dunhuang &amp; Jiuquan?</h2>
      <p class="mt-2 text-lg text-stone-400">敦煌 · 酒泉 · The Hexi Corridor</p>
      <p class="mt-6 text-lg text-stone-600 leading-relaxed">Dunhuang and Jiuquan are two historic Silk Road cities in <strong class="text-stone-800">Gansu Province, northwest China</strong>, sitting 400 km apart along the ancient <strong class="text-stone-800">Hexi Corridor</strong> &mdash; the narrow passage between the Gobi Desert and the Qilian Mountains that served as the main trade route between China and Central Asia for over 1,500 years.</p>
      <p class="mt-4 text-stone-500 leading-relaxed">Dunhuang is an oasis city that hosted Silk Road caravans for two millennia. It is home to the <strong class="text-stone-700">Mogao Caves</strong> (also called the Thousand Buddha Grottoes), a <a href="https://whc.unesco.org/en/list/440/" rel="external nofollow" target="_blank" class="text-mogao-600 hover:text-mogao-700 underline">UNESCO World Heritage Site</a> containing 492 cave temples with Buddhist murals spanning 1,000 years of uninterrupted artistic tradition &mdash; the world's largest and best-preserved treasury of Buddhist art. Around the oasis you will find the <strong class="text-stone-700">Singing Sand Dunes and Crescent Lake</strong>, towering 250-meter sand dunes surrounding a spring-fed lake that has not dried up in 2,000 years.</p>
      <p class="mt-4 text-stone-500 leading-relaxed">Jiuquan guards <strong class="text-stone-700">Jiayuguan Fort</strong> &mdash; the “First and Greatest Pass Under Heaven” and the westernmost fortress of the Ming Dynasty Great Wall, built in 1372. It also hosts <strong class="text-stone-700">China's Satellite Launch Center</strong>, the nation's primary spaceport where all crewed missions depart.</p>
      <p class="mt-4 text-stone-500 leading-relaxed">The two cities are connected by a <strong class="text-stone-700">2.5-hour high-speed train</strong> (CNY 150-200, 10+ departures daily). Together they form the cultural heart of China's Silk Road &mdash; Dunhuang gives you art, desert dunes, and backpacker energy; Jiuquan gives you military history, space exploration, and solitude. Most travelers visit both in a single trip, with Zhangye's <strong class="text-stone-700">Rainbow Mountains</strong> (1.5 hours further east) as a natural third stop.</p>
      <p class="mt-6 text-sm text-stone-400 border-l-2 border-mogao-300 pl-4"><span class="font-semibold text-stone-500">We have visited Dunhuang and Jiuquan across multiple seasons.</span> Every ticket price, train schedule, and practical tip on this page is based on firsthand experience &mdash; most recently verified at attraction gates in July 2026. No AI-generated content. No unverified claims.</p>
    </div>
  </section>

  <section id="at-a-glance" class="mx-auto max-w-7xl px-4 md:px-6 pb-20 md:pb-28 reveal">
    <div class="text-center mb-12"><SectionHeader headingLevel="h2" eyebrow="At a Glance" title="Everything You Need to Know" subtitle="The essentials in one place. If you only read one section, make it this one." center /></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="rounded-2xl border border-stone-200 bg-white p-6">
        <div class="flex items-center gap-2 mb-4"><div class="flex h-8 w-8 items-center justify-center rounded-lg bg-mogao-50"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-mogao-600"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg></div><h3 class="font-semibold text-stone-800">Top Attractions Ranked</h3></div>
        <div class="space-y-3 text-sm">
          <div><span class="inline-block rounded-full bg-mogao-50 px-2 py-0.5 text-xs font-medium text-mogao-700 mb-1">Must see</span><p class="text-stone-600"><strong class="text-stone-700">Mogao Caves</strong> &mdash; UNESCO World Heritage, 492 cave temples. <a href="/mogao-caves" class="text-mogao-600 hover:text-mogao-700 underline">Full guide</a>. <span class="text-stone-400">Allow half a day.</span></p></div>
          <div><span class="inline-block rounded-full bg-mogao-50 px-2 py-0.5 text-xs font-medium text-mogao-700 mb-1">Must see</span><p class="text-stone-600"><strong class="text-stone-700">Crescent Lake &amp; Singing Sand Dunes</strong> &mdash; Spring-fed lake in 250m dunes. Camel rides, sunset photography. 3-day ticket. <a href="/crescent-lake" class="text-mogao-600 hover:text-mogao-700 underline">Full guide</a>.</p></div>
          <div><span class="inline-block rounded-full bg-mogao-50 px-2 py-0.5 text-xs font-medium text-mogao-700 mb-1">Must see</span><p class="text-stone-600"><strong class="text-stone-700">Jiayuguan Fort</strong> &mdash; Western terminus of the Ming Great Wall. “First Pass Under Heaven.” <a href="/jiayuguan-fort" class="text-mogao-600 hover:text-mogao-700 underline">Full guide</a>.</p></div>
          <div><span class="inline-block rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 mb-1">If time allows</span><p class="text-stone-600"><strong class="text-stone-700">Yadan Geopark</strong> &mdash; Surreal wind-carved rock formations. Full-day trip. <a href="/yadan-geopark" class="text-mogao-600 hover:text-mogao-700 underline">Full guide</a>.</p></div>
          <div><span class="inline-block rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 mb-1">If time allows</span><p class="text-stone-600"><strong class="text-stone-700">Satellite Launch Center</strong> &mdash; China's primary spaceport. Book ahead via tour operator.</p></div>
        </div>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-white p-6">
        <div class="flex items-center gap-2 mb-4"><div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600"><path d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg></div><h3 class="font-semibold text-stone-800">Tickets &amp; Budget</h3></div>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between py-1.5 border-b border-stone-100"><span class="text-stone-600">Mogao Caves (A-ticket)</span><span class="font-semibold text-stone-800">CNY 238-258</span></div>
          <div class="flex justify-between py-1.5 border-b border-stone-100"><span class="text-stone-600">Crescent Lake &amp; Dunes</span><span class="font-semibold text-stone-800">CNY 120</span></div>
          <div class="flex justify-between py-1.5 border-b border-stone-100"><span class="text-stone-600">Yadan Geopark</span><span class="font-semibold text-stone-800">CNY 120</span></div>
          <div class="flex justify-between py-1.5 border-b border-stone-100"><span class="text-stone-600">Jiayuguan Fort (combined)</span><span class="font-semibold text-stone-800">CNY 120</span></div>
          <div class="flex justify-between py-1.5 border-b border-stone-100"><span class="text-stone-600">Train Dunhuang rarr Jiuquan</span><span class="font-semibold text-stone-800">CNY 150-200</span></div>
          <div class="flex justify-between py-1.5"><span class="text-stone-500 text-xs">Per person, full visit estimate</span><span class="font-semibold text-mogao-700">CNY 500-1200</span></div>
        </div>
        <p class="text-xs text-stone-400 mt-3">Prices verified at attraction gates, July 2026.</p>
        <a href="/tickets" class="inline-flex items-center gap-1 mt-3 text-xs font-medium text-amber-600 hover:text-amber-700">Full ticket breakdown rarr</a>
      </div>
      <div class="rounded-2xl border border-stone-200 bg-white p-6">
        <div class="flex items-center gap-2 mb-4"><div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 000 20 14.5 14.5 0 000-20"/><path d="M2 12h20"/></svg></div><h3 class="font-semibold text-stone-800">Getting Around</h3></div>
        <ul class="space-y-3 text-sm text-stone-600">
          <li class="flex gap-2"><span class="text-blue-500 shrink-0 mt-0.5">&#9992;</span> Fly into <strong class="text-stone-700">Dunhuang (DNH)</strong> or <strong class="text-stone-700">Jiayuguan (JGN)</strong></li>
          <li class="flex gap-2"><span class="text-blue-500 shrink-0 mt-0.5">&#128646;</span> Train from Lanzhou to Dunhuang: <strong class="text-stone-700">6-8 hours</strong>, CNY 300-400</li>
          <li class="flex gap-2"><span class="text-blue-500 shrink-0 mt-0.5">&#128652;</span> Between cities: <strong class="text-stone-700">2.5-hour train</strong> (10+ daily)</li>
          <li class="flex gap-2"><span class="text-blue-500 shrink-0 mt-0.5">&#128663;</span> Local: <strong class="text-stone-700">Didi via Alipay</strong>. City centers walkable.</li>
          <li class="flex gap-2"><span class="text-blue-500 shrink-0 mt-0.5">&#128161;</span> <span class="text-stone-400">Tip: Fly into Lanzhou and take the train &mdash; saves CNY 500-800.</span></li>
        </ul>
        <a href="/how-to-get-there" class="inline-flex items-center gap-1 mt-4 text-xs font-medium text-blue-600 hover:text-blue-700">Full transport guide rarr</a>
      </div>
    </div>
  </section>
  <section id="when-to-go" class="mx-auto max-w-7xl px-4 md:px-6 pb-20 md:pb-28 reveal">
    <div class="text-center mb-12"><SectionHeader headingLevel="h2" eyebrow="When to Go" title="Pick Your Season" subtitle="Click a season to see what to expect. Each one is completely different on the Silk Road." center /></div>
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-wrap justify-center gap-3 mb-10" role="tablist">
        <button class="season-tab flex flex-col items-center gap-1.5 px-6 py-4 rounded-2xl border-2 transition-all text-sm border-stone-200 bg-white text-stone-500 hover:border-stone-300 hover:text-stone-700" data-season="spring"><span class="text-2xl">&#127800;</span><span class="font-semibold">Spring</span><span class="text-xs opacity-70">Mar-May</span><span class="text-xs font-medium">5-28&deg;C</span></button>
        <button class="season-tab flex flex-col items-center gap-1.5 px-6 py-4 rounded-2xl border-2 transition-all text-sm border-stone-200 bg-white text-stone-500 hover:border-stone-300 hover:text-stone-700" data-season="summer"><span class="text-2xl">&#9728;</span><span class="font-semibold">Summer</span><span class="text-xs opacity-70">Jun-Aug</span><span class="text-xs font-medium">20-40&deg;C</span></button>
        <button class="season-tab flex flex-col items-center gap-1.5 px-6 py-4 rounded-2xl border-2 transition-all text-sm border-mogao-300 bg-mogao-50 text-mogao-700 shadow-sm" data-season="autumn"><span class="text-2xl">&#127810;</span><span class="font-semibold">Autumn</span><span class="text-xs opacity-70">Sep-Oct</span><span class="text-xs font-medium">5-25&deg;C</span></button>
        <button class="season-tab flex flex-col items-center gap-1.5 px-6 py-4 rounded-2xl border-2 transition-all text-sm border-stone-200 bg-white text-stone-500 hover:border-stone-300 hover:text-stone-700" data-season="winter"><span class="text-2xl">&#9924;</span><span class="font-semibold">Winter</span><span class="text-xs opacity-70">Nov-Feb</span><span class="text-xs font-medium">-10 to 5&deg;C</span></button>
      </div>
      <div id="season-detail" class="bg-stone-50 rounded-2xl p-8 border border-stone-200 min-h-[200px]">
        <div class="flex items-start gap-3">
          <span class="mt-1 w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-700 text-lg shrink-0">&#127810;</span>
          <div>
            <h3 class="text-xl font-semibold text-stone-900 mb-2">Autumn (Sep-Oct) &mdash; The Best Season</h3>
            <p class="text-stone-600 leading-relaxed">September is magnificent: 15-25&deg;C, golden light, crystal-clear skies. October equally good &mdash; but <strong class="text-stone-800">avoid the first week</strong> (Golden Week, Oct 1-7) when every attraction is overrun. This is the season we recommend to friends: comfortable temperatures, manageable crowds (after Oct 7), and the best light for photography.</p>
            <div class="mt-4 flex flex-wrap gap-3 text-sm">
              <span class="rounded-full bg-green-100 px-3 py-1 text-green-700 font-medium">Crowds: Moderate</span>
              <span class="rounded-full bg-green-100 px-3 py-1 text-green-700 font-medium">Hotels: Normal price</span>
              <span class="rounded-full bg-green-100 px-3 py-1 text-green-700 font-medium">Photos: Best light</span>
            </div>
          </div>
        </div>
      </div>
      <p class="mt-4 text-center text-sm text-stone-400"><a href="/best-time-to-visit" class="text-mogao-600 hover:text-mogao-700 underline font-medium">Month-by-month breakdown &amp; weather data rarr</a></p>
    </div>
  </section>

  <section id="compare" class="py-24 bg-white">
    <div class="section-container">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-900 text-center">Dunhuang vs Jiuquan at a Glance</h2>
