---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";

// Single source of truth for this page's FAQ: feeds both the FAQPage JSON-LD and
// the visible accordion. Every answer restates facts already given in the
// day-by-day plans above, so the marked-up text and the visible text stay identical.
const faqs = [
  {
    q: "How many days do I need for Dunhuang and Jiuquan?",
    a: "Three days covers Dunhuang alone. Five days is the classic route and the one we recommend to first-time visitors: it adds Jiayuguan Fort and the western end of the Great Wall. Seven days extends the corridor to Zhangye and the Rainbow Mountains.",
  },
  {
    q: "How much does a Dunhuang and Jiuquan trip cost?",
    a: "Roughly CNY 800-1200 per person for the 3-day plan, CNY 1500-2200 for the classic 5-day route, and CNY 2200-3200 for the 7-day version. That covers accommodation, meals, attraction tickets and transport between cities, but not your flight or train into Dunhuang.",
  },
  {
    q: "Do I need to hire a private driver in Dunhuang?",
    a: "For the west line, yes. Yumen Pass and Yadan Geopark have no public transport, so you need a private driver at around CNY 600-800 per day - split the cost with other travellers if you can. Pack lunch and water, because there are no food options en route.",
  },
  {
    q: "Can I visit Dunhuang and Jiuquan without a car?",
    a: "Yes for the cities themselves. The high-speed train between Dunhuang and Jiuquan takes 2.5 hours and costs CNY 150-200, and both city centres are walkable or served by cheap taxis. The only stretch that genuinely requires a car is the Dunhuang west line.",
  },
  {
    q: "Should I book Mogao Caves before I arrive?",
    a: "Yes, and as early as you can. A-tickets sell out 2-4 weeks ahead in July, August and around Golden Week in early October. Every plan here assumes an 8 AM start at the caves, which means an early slot at the Digital Exhibition Center for the two films before the guided cave tour.",
  },
];

const schema = {"@context":"https://schema.org","@graph":[{"@type":"Article","headline":"Dunhuang & Jiuquan Itineraries: 3, 5 & 7 Day Plans (2026)","description":"Flexible Silk Road itineraries with field-tested timing and budgets: 3-day express, classic 5-day, and in-depth 7-day plans.","datePublished":"2026-07-15","dateModified":"2026-09-17"},{"@type":"FAQPage","mainEntity":faqs.map((f)=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))}]};

const day3Schedule = [
  {time:"8:00 AM",act:"Mogao Caves A-ticket tour. Arrive at Digital Exhibition Center 30 min early for the two films. The dome theater is impressive."},
  {time:"11:00 AM",act:"Guided cave tour (75 min, 8 caves). Explore the nine-story facade and museum. Souvenir shop here has better reproductions than the night market."},
  {time:"12:30 PM",act:"Lunch near Shazhou Night Market. Try donkey-meat noodles at Shunzhang Huangmian Guan."},
  {time:"2:00 PM",act:"Crescent Lake and Singing Sand Dunes. Walk or camel ride to the dunes. Climb to the ridge for the best view."},
  {time:"5:30 PM",act:"Stay for sunset. The dunes turn golden. Best photos of the day."},
  {time:"7:30 PM",act:"Dinner at Shazhou Night Market. Lamb skewers and apricot drink."}
];

const itineraries = [
  {
    days: "3 Days (Express)", badge: "Dunhuang only", ideal: "If you only have a long weekend, focus entirely on Dunhuang. Jiuquan needs more time.", budget: "CNY 800-1200 per person", plan: [
      { title: "Mogao Caves & Desert", items: ["8 AM: Mogao Caves (book ahead)", "Afternoon: Crescent Lake, climb dunes", "Sunset: Camel ride (CNY 100)", "Stay: Dunhuang city center (CNY 150-300)"] },
      { title: "West Line Adventure", items: ["Full day: Yumen Pass (CNY 40) + Yadan Geopark (CNY 120)", "Hire private driver (CNY 600-800, split with others)", "Pack lunch and water. No food options en route", "Stay: Dunhuang"] },
      { title: "Departure", items: ["Morning: Dunhuang Museum (free, 1-2 hours)", "Lunch: Last bowl of Lanzhou beef noodles", "Afternoon: Train or flight out"] }
    ]
  },
  {
    days: "5 Days (Classic)", badge: "Dunhuang + Jiuquan", ideal: "The sweet spot. Covers both cities comfortably. This is the itinerary we recommend to friends.", budget: "CNY 1500-2200 per person", plan: [
      { title: "Arrive Dunhuang", items: ["Check in. Evening: Shazhou Night Market", "Try lamb skewers, apricot drink, stuffed buns", "Stay: Dunhuang city center (CNY 150-300/night)"] },
      { title: "Mogao Caves & Desert", items: ["8 AM: Mogao Caves A-ticket. 8 caves + 2 films", "Afternoon: Crescent Lake. Camel ride (CNY 100)", "Sunset: Dune photography. Best light 1 hour before sunset", "Stay: Dunhuang"] },
      { title: "Yadan & West Line", items: ["Full day: Yumen Pass + Yadan Geopark", "Private driver required (CNY 600-800)", "Evening: Last Dunhuang dinner. Try hot pot", "Stay: Dunhuang"] },
      { title: "Train to Jiuquan", items: ["Morning: High-speed train (2.5h, CNY 150-200)", "Afternoon: Jiayuguan Fort (CNY 120 combined)", "Sunset: Overhanging Great Wall (included). Qilian Mountain views", "Stay: Jiayuguan downtown (CNY 200-500)"] },
      { title: "Jiuquan & Depart", items: ["Morning: Satellite Launch Center (CNY 150, book ahead)", "OR Wei-Jin Tombs (CNY 80) if space center unavailable", "Evening: Depart from Jiayuguan Airport (JGN)"] }
    ]
  },
  {
    days: "7 Days (In-Depth)", badge: "Full Silk Road", ideal: "Dunhuang + Jiuquan + Zhangye Rainbow Mountains. The complete Gansu Corridor experience.", budget: "CNY 2200-3200 per person", plan: [
      { title: "Arrive Dunhuang", items: ["Check in. Evening: Shazhou Night Market dinner", "Stay: Dunhuang city center"] },
      { title: "Mogao Caves Full Day", items: ["8 AM: Mogao Caves A-ticket", "Afternoon: Dunhuang Museum (free)", "Evening: Explore city. Local hot pot", "Stay: Dunhuang"] },
      { title: "Desert & Dunes", items: ["Morning: Crescent Lake, climb dunes (best light)", "Afternoon: Rest or explore old town", "Sunset: Return to dunes for photography", "Stay: Dunhuang"] },
      { title: "West Line Expedition", items: ["Full day: Yumen Pass + Yadan Geopark", "Sunset at Yadan is the highlight", "Stay: Dunhuang"] },
      { title: "Train to Jiuquan", items: ["Morning: High-speed train (2.5h)", "Afternoon: Jiayuguan Fort + Museum", "Evening: Jiuquan old town, lamb soup", "Stay: Jiayuguan downtown"] },
      { title: "Great Wall & Zhangye", items: ["Morning: Overhanging Great Wall hike (30 min uphill)", "Afternoon: Train to Zhangye (1.5h, CNY 80-120)", "Evening: Zhangye food street near Drum Tower", "Stay: Zhangye city center"] },
      { title: "Rainbow Mountains", items: ["Morning: Zhangye Danxia Geopark (CNY 75, arrive by 7 AM)", "Midday: Mati Temple if time allows", "Evening: Depart from Zhangye West Station"] }
    ]
  }
];
---

<BaseLayout title="Dunhuang &amp; Jiuquan Itineraries 2026 | 3, 5 &amp; 7 Day Plans" description="Field-tested Silk Road itineraries with realistic timing, budgets, and honest day-by-day tips: 3-day express, classic 5-day, and in-depth 7-day plans." author="Dunhuang &amp; Jiuquan Guide Team" datePublished="2026-07-15" dateModified="2026-08-07">
<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema)}></script></Fragment>

<div class="u-prose-wrap pb-20 md:pb-28">
  <header class="pt-12 md:pt-20 mb-16 reveal">
    <SectionHeader eyebrow="Itineraries" title="3, 5 &amp; 7 Day Itineraries" subtitle="Field-tested Silk Road plans with realistic timing and budgets. Exact routes we recommend to friends visiting for the first time. All assume a 7-8 AM start." />
  </header>
      <!-- Placeholder image - replace with real photography -->
      <div class="u-figure">
        <img src="/images/itinerary.webp?v=2" alt="Silk Road Itinerary Plans" class="u-img" width="1200" height="600" loading="lazy" />
      </div>

  <!-- Lead answer — direct response to search intent, rendered without reveal -->
  <p class="text-lg text-stone-700 leading-relaxed mb-12">
    <strong class="text-stone-900">Five days is the classic Dunhuang and Jiuquan route.</strong> Three days covers Dunhuang alone, five adds Jiayuguan Fort and the western end of the Great Wall, and seven extends the corridor to Zhangye's Rainbow Mountains. Budget <strong class="text-stone-900">CNY 800-1200</strong> (3 days), <strong class="text-stone-900">CNY 1500-2200</strong> (5 days) or <strong class="text-stone-900">CNY 2200-3200</strong> (7 days) per person. Every plan below assumes a 7-8 AM start, and the one fixed constraint is Mogao Caves &mdash; book the A-ticket ahead.
  </p>

  <section class="mb-20 reveal">
    <div class="flex items-center gap-3 mb-2"><span class="text-xs font-semibold text-mogao-600 uppercase tracking-wide bg-mogao-50 rounded-full px-3 py-1">3 Days</span><span class="text-xs text-stone-500">Dunhuang focus</span></div>
    <h2 class="text-2xl font-display u-strong">Express: The Silk Road Essentials</h2>
    <p class="mt-2 text-stone-500 leading-relaxed">Three full days in Dunhuang. You will see Mogao Caves, climb the dunes, and explore Yadan's surreal rock formations. Jiuquan is skipped — there is not enough time for both. Tested in June 2026.</p>
    <p class="mt-4 text-sm text-stone-500">Where to stay: Dunhuang city center near Shazhou Night Market. Hotels from CNY 150/night.</p>
    <div class="mt-6 rounded-xl border border-stone-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-stone-50 border-b border-stone-200"><tr><th class="text-left px-5 py-3 font-medium text-stone-700 w-28">Time</th><th class="text-left px-5 py-3 font-medium text-stone-700">Activity</th></tr></thead>
        <tbody class="divide-y divide-stone-100">
          {day3Schedule.map((item) => (<tr class="hover:bg-stone-50"><td class="px-5 py-3 text-stone-500 font-medium whitespace-nowrap">{item.time}</td><td class="px-5 py-3 text-stone-600">{item.act}</td></tr>))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-stone-500">Budget: Mogao CNY 238 + dunes CNY 120 + Yadan/Yumen CNY 160 + driver CNY 200 + meals CNY 150 + 2 nights CNY 300</p>
  </section>

  {itineraries.slice(1).map((itin) => (
    <section class="mb-20 reveal">
      <div class="flex items-center gap-3 mb-2"><span class="text-xs font-semibold text-mogao-600 uppercase tracking-wide bg-mogao-50 rounded-full px-3 py-1">{itin.days.split(" ")[0]} Days</span><span class="text-xs text-stone-500">{itin.badge}</span></div>
      <h2 class="text-2xl font-display u-strong">{itin.days.split(" (")[1]?.replace(")", "") || ""}</h2>
      <p class="mt-2 text-stone-500 leading-relaxed">{itin.ideal}</p>
      <p class="mt-3 text-sm text-stone-500">Budget: <strong class="text-stone-600">{itin.budget}</strong></p>
      <div class="mt-6 space-y-4">
        {itin.plan.map((d, i) => (
          <div class="rounded-xl border border-stone-200 bg-white p-5">
            <h3 class="font-semibold text-stone-800 text-lg mb-3">Day {i + 1}: {d.title}</h3>
            <ul class="space-y-1.5 text-sm">
              {d.items.map((item) => (<li class="u-li text-stone-500"><span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-mogao-400 shrink-0"></span>{item}</li>))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ))}

  <!-- FAQ — visible content backing the FAQPage schema above.
       Deliberately not using .reveal: this is SEO-critical content and
       .reveal starts at opacity:0 on desktop. -->
  <section class="mb-16">
    <h2 class="u-h2">Itinerary Questions Travelers Ask</h2>
    <div class="space-y-3">
      {faqs.map((f) => (
        <details class="group bg-white rounded-2xl border border-stone-200">
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer text-left u-strong list-none">
            {f.q}
            <svg class="w-5 h-5 shrink-0 text-stone-500 group-open:rotate-180 transition-transform" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="px-6 pb-5 text-stone-600 text-sm leading-relaxed">{f.a}</div>
        </details>
      ))}
    </div>
  </section>

  <div class="pt-12 border-t border-stone-200 text-center reveal">
    <p class="text-stone-500 text-sm mb-6">Want a custom plan? Use our interactive trip planner on the homepage.</p>
    <a href="/#planner" class="inline-flex items-center gap-2 rounded-xl bg-mogao-600 px-6 py-3 text-sm font-semibold text-white hover:bg-mogao-700 transition">Open Trip Planner</a>
  </div>
</div>
</BaseLayout>

