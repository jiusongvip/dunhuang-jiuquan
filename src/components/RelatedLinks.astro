---
interface Props {
  title?: string;
  links: { href: string; label: string }[];
}

const { title = "People also search for", links = [] } = Astro.props;
---

<section class="py-12 md:py-16 border-t border-slate-200">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="flex items-center gap-3 mb-4">
      <span class="inline-block h-px w-8 bg-mogao-500/60"></span>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-mogao-600">Related Searches</p>
    </div>
    <h2 class="font-display text-2xl md:text-3xl font-semibold text-stone-900 mb-6">{title}</h2>
    <div class="flex flex-wrap gap-3 max-w-3xl">
      {links.map((l) => (
        <a
          href={l.href}
          class="px-4 py-2 border border-stone-200 rounded-full text-sm text-stone-600 hover:text-mogao-700 hover:border-mogao-300 hover:bg-mogao-50/40 transition"
        >
          {l.label}
        </a>
      ))}
    </div>
  </div>
</section>