---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";

const faqs = [
  { q: "Is there a high-speed train to Dunhuang?", a: "Yes. Dunhuang has a high-speed rail station on the Lanzhou-Xinjiang line, with direct services from Lanzhou (about 6-8 hours), Xining, Zhangye and Jiayuguan (about 2.5 hours). There is no high-speed line from Beijing or Shanghai yet — from those cities you either fly or take an overnight sleeper." },
  { q: "How far is Dunhuang railway station from the city centre?", a: "About 10 km, roughly 20 minutes and CNY 25-30 by taxi. City bus No. 3 also runs the route for CNY 2. Most hotels are within a short walk of the night market, so the total journey is quick." },
  { q: "Should I fly or take the train to Dunhuang?", a: "Fly if you are coming from Beijing, Shanghai, Guangzhou or Chengdu — the train takes 20+ hours. Take the train if you are already in Gansu or Qinghai; the Hexi Corridor scenery between Zhangye and Dunhuang is part of the experience, and the fares are far lower." },
  { q: "Do I need to book train tickets in advance?", a: "Yes, especially from May to October. Chinese rail tickets open for sale roughly 15 days before departure and popular Dunhuang services sell out quickly. Book through Trip.com or Ctrip with your passport number — your passport is your ticket at the gate." },
];

const stationInfo = [
  { label: "Dunhuang Railway Station", value: "10 km from city centre" },
  { label: "Taxi to city centre", value: "CNY 25-30, ~20 min" },
  { label: "City bus to centre", value: "Bus No. 3, CNY 2" },
  { label: "Dunhuang Airport (DNH)", value: "13 km from city centre" },
  { label: "Airport shuttle", value: "CNY 10" },
  { label: "Airport taxi", value: "CNY 30-40" },
];

const schema = {"@context":"https://schema.org","@graph":[{"@type":"Article","headline":"How to Get to Dunhuang by Train & Plane (2026 Gansu Guide)","description":"Every way to reach Dunhuang and Jiuquan: flights, high-speed trains, buses, private cars. Routes from Lanzhou, Xi'an, Beijing, and between the two cities.","datePublished":"2026-07-01","dateModified":"2026-09-16"},{"@type":"FAQPage","mainEntity":faqs.map((f)=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))}]};

const dunhuangOptions = [
  { method: "By Air", duration: "2-4 hours from major cities", cost: "CNY 500-2000", steps: ["Dunhuang Mogao International Airport (DNH) has domestic flights from Beijing, Xi'an, Lanzhou, Chengdu, and Urumqi", "Most international travelers fly into Lanzhou (LHW) and connect by train (6-8 hours)", "Airport is 13 km from Dunhuang city center. Airport shuttle bus CNY 10, taxi CNY 30-40"] },
  { method: "By High-Speed Train", duration: "6-8 hours from Lanzhou", cost: "CNY 300-400", steps: ["Dunhuang Station is 10 km from city center. Bus No. 3 connects to the city (CNY 2)", "High-speed line opened in 2023. Connects to Lanzhou, Zhangye, and Jiayuguan/Jiuquan", "Book on Trip.com or at the station. Second class seats are comfortable with AC"] },
  { method: "By Long-Distance Bus", duration: "12-14 hours from Lanzhou", cost: "CNY 150-200", steps: ["Overnight sleeper buses available from Lanzhou Bus Station", "Slower and less comfortable than trains. Use only if trains are sold out", "Dunhuang Bus Station is on Mingshan Road in the city center"] },
];

const dunhuangToJiuquan = [
  { method: "High-Speed Train", duration: "2.5 hours", cost: "CNY 150-200", freq: "10+ daily", best: true, note: "Clear winner. Comfortable second class seats. Power outlets at every seat. Book on Trip.com or at station." },
  { method: "Long-Distance Bus", duration: "5-6 hours", cost: "CNY 60-80", freq: "4-6 daily", best: false, note: "Budget pick. Slower but scenic route along the Hexi Corridor. Depart from Dunhuang Bus Station." },
  { method: "Private Car", duration: "4-5 hours", cost: "CNY 600-900", freq: "By arrangement", best: false, note: "Most flexible. Stop anywhere along the route. Arrange through hotel or Didi. Good for photography stops." },
  { method: "Flight", duration: "1 hour", cost: "CNY 800-1500", freq: "1-2 daily", best: false, note: "Fastest but rare. Only makes sense if connecting to an onward flight. DNH to JGN." },
];
---

<BaseLayout title="How to Get to Dunhuang by Train &amp; Plane (2026 Gansu Guide)" description="Every way to reach Dunhuang: flights, high-speed trains, buses and private cars, plus station and airport transfers. Routes from Lanzhou, Xining and Beijing." author="Dunhuang &amp; Jiuquan Guide Team" datePublished="2026-07-01" dateModified="2026-09-16">
<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema)}></script></Fragment>

<div class="u-prose-wrap pb-20 md:pb-28">
  <header class="pt-12 md:pt-20 mb-16 reveal">
    <SectionHeader eyebrow="Transportation" title="How to Get to Dunhuang &amp; Jiuquan" subtitle="Every way to reach the Silk Road: flights, trains, buses, and driving routes. Pros and cons for each option, with current prices." />
  </header>

  <!-- Lead answer — direct response to "how to get to dunhuang" intent, rendered without reveal -->
  <p class="text-lg text-stone-700 leading-relaxed mb-10">
    The practical answer: <strong class="text-stone-900">fly into Dunhuang (DNH) if you are coming from Beijing, Shanghai or Chengdu, and take the high-speed train if you are already in Gansu or Qinghai</strong>. Dunhuang's rail station sits on the Lanzhou-Xinjiang high-speed line, 6-8 hours from Lanzhou and 2.5 hours from Jiayuguan. From the station to the city centre is 20 minutes and about CNY 30.
  </p>

      <!-- Placeholder image - replace with real photography -->
      <div class="u-figure">
        <img src="/images/how-to-get-there.webp?v=2" alt="How to Get to Dunhuang and Jiuquan" class="u-img" width="1200" height="600" loading="lazy" />
      </div>

  <section class="mb-16 reveal">
    <h2 class="text-2xl font-display u-strong mb-6">Getting to Dunhuang</h2>
    <div class="space-y-5">
      {dunhuangOptions.map(({ method, duration, cost, steps }) => (
        <div class="u-card">
          <h3 class="u-strong">{method} <span class="text-xs font-normal text-stone-500">({duration}, {cost})</span></h3>
          <ul class="mt-2 space-y-1.5 text-sm text-stone-500">
            {steps.map((s) => (<li class="u-li"><span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-mogao-400 shrink-0"></span>{s}</li>))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16 reveal">
    <h2 class="text-2xl font-display u-strong mb-6">Dunhuang to Jiuquan: Route Comparison</h2>
    <div class="rounded-xl border border-stone-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-stone-50 border-b border-stone-200">
          <tr>
            <th class="text-left px-5 py-3 font-medium text-stone-700">Method</th>
            <th class="text-center px-5 py-3 font-medium text-stone-700">Duration</th>
            <th class="text-center px-5 py-3 font-medium text-stone-700">Cost (CNY)</th>
            <th class="text-center px-5 py-3 font-medium text-stone-700 hidden sm:table-cell">Frequency</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          {dunhuangToJiuquan.map((r) => (
            <tr class="hover:bg-stone-50">
              <td class="px-5 py-3 font-medium">{r.best ? <span class="text-mogao-600">{r.method}</span> : r.method}{r.best && <span class="ml-2 rounded-full bg-mogao-50 px-2 py-0.5 text-[10px] font-semibold text-mogao-600">Best</span>}</td>
              <td class="text-center px-5 py-3 text-stone-600">{r.duration}</td>
              <td class="text-center px-5 py-3 text-stone-600">{r.cost}</td>
              <td class="text-center px-5 py-3 text-stone-500 text-xs hidden sm:table-cell">{r.freq}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-stone-500">The high-speed train is the clear winner for most travelers. Book on Trip.com, Ctrip, or at the station.</p>
  </section>

  <section class="mb-16 reveal">
    <h2 class="text-2xl font-display u-strong mb-6">Dunhuang Railway Station &amp; Airport: Practical Info</h2>
    <p class="text-stone-600 leading-relaxed mb-5">Both the rail station and the airport sit outside the city. Neither is walkable, but transfers are cheap and quick, and the city centre itself is compact.</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      {stationInfo.map(({ label, value }) => (
        <div class="u-stat"><p class="u-eyebrow">{label}</p><p class="mt-1 u-strong text-sm">{value}</p></div>
      ))}
    </div>
    <p class="mt-4 text-xs text-stone-500">Your passport is your train ticket — there is no separate paper ticket to collect. Allow 30 minutes before departure for security and passport checks.</p>
  </section>

  <!-- FAQ — visible content backing the FAQPage schema above -->
  <section class="mb-16">
    <h2 class="text-2xl font-display u-strong mb-6">Frequently Asked Questions</h2>
    <div class="space-y-3">
      {faqs.map((f) => (
        <details class="group bg-white rounded-2xl border border-stone-200">
          <summary class="flex items-center justify-between px-6 py-5 cursor-pointer text-left u-strong list-none">
            {f.q}
            <svg class="w-5 h-5 shrink-0 text-stone-500 group-open:rotate-180 transition-transform" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="px-6 pb-5 text-stone-600 text-sm leading-relaxed">{f.a}</div>
        </details>
      ))}
    </div>
  </section>

  <div class="u-cta-card reveal">
    <h3 class="text-xl font-display font-semibold">Plan your route</h3>
    <p class="mt-2 text-mogao-100 text-sm">Our trip planner helps you pick the best connections between cities.</p>
    <a href="/#planner" class="u-btn-outline2">Build My Route</a>
  </div>
</div>
</BaseLayout>

