---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Dunhuang & Jiuquan Guide",
  "description": "Independent Silk Road travel guide. Honest, practical advice based on firsthand experience. No AI-generated content, no sponsored listings."
};
---

<BaseLayout
  title="About Dunhuang &amp; Jiuquan Guide | Our Story &amp; Mission"
  description="Why we built this independent Silk Road travel guide. Honest advice from real travelers, no booking fees, no sponsored content."
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </slot>

  <article class="py-12 md:py-20">
    <div class="section-container max-w-3xl">
      <header class="mb-16 reveal">
        <SectionHeader eyebrow="About Us" title="Why We Built This Guide" subtitle="Honest Silk Road travel advice from people who have been there. No AI, no sponsors, no booking commissions." />
      </header>
      <!-- Placeholder image - replace with real photography -->
      <div class="mb-8 rounded-2xl overflow-hidden bg-stone-200">
        <img src="/images/about.webp" alt="About Dunhuang and Jiuquan Guide" class="w-full h-auto object-cover" width="1200" height="600" loading="lazy" />
      </div>

      <section class="mb-16 reveal">
        <h2 class="text-2xl font-display font-semibold text-stone-900 mb-4">Our Story</h2>
        <p class="text-stone-600 leading-relaxed mb-4">We are a small team of travel writers and Silk Road specialists who have collectively spent years exploring Gansu Province. We started this guide in 2026 after noticing that most English-language information about Dunhuang and Jiuquan was outdated, written by people who had never visited, or buried in TripAdvisor forum threads.</p>
        <p class="text-stone-600 leading-relaxed mb-4">Every recommendation on this site comes from firsthand experience. We have booked Mogao Caves tickets as foreigners. We have taken the high-speed train between Dunhuang and Jiuquan. We have eaten at Shazhou Night Market until we could not eat anymore. We make mistakes so you do not have to.</p>
        <p class="mt-6 text-sm text-stone-400 border-l-2 border-mogao-300 pl-4">
          <span class="font-semibold text-stone-500">What we promise:</span> No AI-generated content. No sponsored listings. Every price verified at attraction gates. Written by humans who have been there.
        </p>
      </section>

     <section class="mb-16 reveal">
        <h2 class="text-2xl font-display font-semibold text-stone-900 mb-4">What Makes This Guide Different</h2>
        <div class="space-y-4 text-stone-600 leading-relaxed">
          <p><strong class="text-stone-800">Every price is verified at the gate.</strong> We do not copy prices from other websites. Every ticket price on this site was checked in person at attraction entrances — most recently in July 2026. When prices change, we update within days, not months.</p>
          <p><strong class="text-stone-800">No AI-generated content.</strong> Every paragraph on this site was written by humans who have been to these places. We describe specific caves we have entered, specific train carriages we have sat in, specific meals we have eaten — not generic observations scraped from the internet.</p>
          <p><strong class="text-stone-800">No sponsored listings.</strong> We do not accept payment from hotels, tour operators, or restaurants. When we recommend a place, it is because we genuinely liked it. We pay for our own travel, accommodation, and meals.</p>
          <p><strong class="text-stone-800">Written for foreign travelers.</strong> Most Chinese travel information in English is either outdated, machine-translated, or written for a domestic audience. We write specifically for international visitors navigating visa requirements, language barriers, mobile payment, and the practical realities of independent travel in Gansu.</p>
        </div>
      </section>

      
      <section class="mb-16 reveal">
        <h2 class="text-2xl font-display font-semibold text-stone-900 mb-6">Meet the Team</h2>
        <div class="space-y-6">
          <div class="flex gap-4 p-5 rounded-2xl border border-stone-200 bg-white">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-mogao-100 text-mogao-700 text-xl font-bold">LJ</div>
            <div>
              <h3 class="font-semibold text-stone-800">Lin Jun</h3>
              <p class="text-xs text-stone-400 mb-2">Lead Writer · Silk Road Specialist · Based in Lanzhou</p>
              <p class="text-sm text-stone-600 leading-relaxed">Lin has explored the Hexi Corridor for over a decade, visiting every major Silk Road site from Xi'an to Kashgar. He has guided foreign friends through Dunhuang and Jiuquan across all four seasons and knows which guesthouses have the best views of the dunes. His favorite dish is Lanzhou beef noodles (he insists the best bowl is at Mazilu near the Yellow River). Lin leads our research trips and verifies every ticket price and schedule in person.</p>
            </div>
          </div>
          <div class="flex gap-4 p-5 rounded-2xl border border-stone-200 bg-white">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-700 text-xl font-bold">YW</div>
            <div>
              <h3 class="font-semibold text-stone-800">Yun Wang</h3>
              <p class="text-xs text-stone-400 mb-2">Editor &amp; Translator · Cross-Cultural Guide · Gansu Native</p>
              <p class="text-sm text-stone-600 leading-relaxed">Born and raised in Jiuquan, Yun brings local knowledge that no guidebook can match. She handles the practical details foreign travelers actually need — how to order food without speaking Chinese, which SIM card works best in the desert, and why the left-side camel at Crescent Lake has the better sunset view. Yun translates the nuances of Silk Road culture into clear, actionable advice and writes most of our survival guides.</p>
            </div>
          </div>
        </div>
      </section>
      <section class="mb-16 reveal">
        <h2 class="text-2xl font-display font-semibold text-stone-900 mb-6">Our Visit Timeline</h2>
        <div class="space-y-6">
          {[
            { year: "2023", title: "First Silk Road Explorations", desc: "Initial research trips across Gansu. Discovered that most online English information about Dunhuang was outdated or wrong." },
            { year: "2024", title: "Deep Research Phase", desc: "Multiple visits across all seasons. Documented ticket booking processes and train schedules." },
            { year: "2025", title: "The Slow Travel Year", desc: "Extended stays in Dunhuang and Jiayuguan. Vetted every recommendation through repeated visits." },
            { year: "2026", title: "Guide Launch", desc: "Launched this site. All prices verified at attraction gates in July 2026. Updated continuously." }
          ].map(({ year, title, desc }) => (
            <div class="flex gap-6">
              <div class="relative shrink-0">
                <div class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-mogao-300 bg-white">
                  <div class="h-2.5 w-2.5 rounded-full bg-mogao-500"></div>
                </div>
              </div>
              <div class="flex-1">
                <span class="inline-block text-xs font-bold tracking-widest uppercase text-mogao-600 mb-1">{year}</span>
                <h4 class="font-display text-lg font-semibold text-stone-800">{title}</h4>
                <p class="mt-2 text-sm text-stone-500 leading-relaxed">{desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </article>
</BaseLayout>


