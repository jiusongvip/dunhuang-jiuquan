---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";

const museums = [
  {
    name: "Dunhuang Museum (敦煌市博物馆)",
    city: "Dunhuang",
    price: "Free (passport required)",
    time: "1.5-2 hours",
    body: "The best free context stop before Mogao. Covers the pre-Qin to modern history of the oasis, with the most accessible explanation of the Silk Road's local role. The later halls lean on 3D reconstructions of the caves; the earlier halls hold genuine local finds, including Wei-Jin murals recovered from tombs outside the city.",
  },
  {
    name: "Dunhuang Art Gallery / Mogao replica hall",
    city: "Dunhuang (Mogao ticket included)",
    price: "Included with Mogao A-ticket",
    body: "Inside the Mogao complex, the replica cave exhibition allows photography of famous cave interiors that visitors never enter. The replica caves were painted over years by the Dunhuang Academy. Combine it with the Digital Exhibition Center films to take home what the real caves strictly forbid.",
  },
  {
    name: "Great Wall Museum (Jiayuguan)",
    city: "Jiayuguan",
    price: "Included with fort combined ticket",
    hours: "2 hours (inside Fort complex)",
    body: "The most comprehensive Great Wall museum in western China. It does a genuinely good job of explaining the difference between Ming Great Wall and earlier Han rammed-earth walls — which matters because Jiayuguan's Han walls are older and simpler than the brick Ming fort.",
  },
  {
    name: "Satellite Launch Center Exhibits",
    city: "Jiuquan (via tour operator)",
    price: "Visitor center CNY 150 (arranged)",
    body: "Not a museum in the walk-in sense — access requires a pre-arranged tour. The visitor center exhibits the Chang Zheng (Long March) rocket family and lunar programs. All crewed missions launch from here. Understand the limited foreign-access rules before booking.",
  },
  {
    name: "Yulin Caves (榆林窟) — the Mogao alternative",
    city: "Guazhou (170 km from Dunhuang)",
    price: "CNY 100 (approx)",
    body: "Yulin Caves spread the Mogao-style murals across a river canyon with far fewer visitors. Not a museum in the formal sense, but for anyone who could not book Mogao A-tickets it is the closest living equivalent: same painting tradition, comparable detail, and about a quarter of the crowds. Allow a full day round trip from Dunhuang.",
  },
  {
    name: "Gansu Provincial Museum (Lanzhou)",
    city: "Lanzhou (gateway by HSR)",
    price: "Free (reserve on WeChat)",
    body: "Worth building into the corridor itinerary. Global Silk Road context; the galloping horse sculpture of Han Gansu; and artifacts from the Hexi corridor itself. Reserve 3-5 days ahead on the official WeChat mini-program.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Dunhuang & Jiuquan Museum Guide",
  description: "The best museums in Dunhuang, Jiayuguan and Lanzhou for Silk Road history and art — with tickets, hours, and which are worth the journey.",
  mainEntity: museums.map((m) => ({
    "@type": "Museum",
    name: m.name,
    description: m.body,
  })),
};
---

<BaseLayout
  title="Museums in Dunhuang and Jiuquan | Silk Road Museum Guide"
  description="The best museums in Dunhuang and Jiuquan for Silk Road history: Dunhuang Museum, Great Wall Museum, Mogao Art replicas, and Gansu Provincial Museum. Prices and what to prioritize."
  ogType="article"
  ogImage="/images/about.webp"
  ogImageWidth="1536"
  ogImageHeight="1024"
  ogImageAlt="Dunhuang Silk Road museum guide"
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </slot>

  <article class="py-12 md:py-20">
    <div class="section-container max-w-4xl">
      <header class="mb-12 reveal">
        <SectionHeader
          eyebrow="Museum Guide"
          title="Museums on the Silk Road: Dunhuang and Jiuquan"
          subtitle="Six institution options that build the corridor story — from the free city museum to the replica Mogao caves. Practical tickets, time, and which ones truly justify a detour."
        />
      </header>

      <div class="space-y-6">
        {museums.map((m, i) => (
          <section class="bg-white rounded-2xl border border-stone-200 p-6 md:p-8 reveal">
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-3">
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-stone-900">{m.name}</h2>
              <span class="shrink-0 inline-flex items-center rounded-full bg-mogao-50 px-3 py-1 text-xs font-semibold text-mogao-700">{m.city}</span>
            </div>
            <div class="flex flex-wrap gap-4 text-sm text-stone-600 mb-4">
              {m.price && <span><strong class="text-stone-800">Price:</strong> {m.price}</span>}
              {m.hours && <span><strong class="text-stone-800">Allow:</strong> {m.hours}</span>}
            </div>
            <p class="text-stone-600 leading-relaxed">{m.body}</p>
          </section>
        ))}
      </div>

      <div class="mt-12 p-6 bg-mogao-50 rounded-2xl border border-mogao-200 reveal">
        <h2 class="text-lg font-semibold text-stone-900 mb-2">Our one-line verdict</h2>
        <p class="text-stone-600 text-sm leading-relaxed">
          If you only see one museum, make it the <strong>Dunhuang Museum first</strong> — it is free and sets up everything you will see at Mogao. If your Mogao A-ticket already includes the replica gallery, spend the saved time inside the Great Wall Museum in Jiayuguan.
        </p>
      </div>

      <div class="mt-12 p-6 bg-amber-50 rounded-2xl border border-amber-200 reveal">
        <h2 class="text-lg font-semibold text-stone-900 mb-2">Before you go</h2>
        <ul class="mt-2 space-y-2 text-sm text-stone-700">
          <li>&rarr; Carry your passport — most free Chinese museums now require real-name registration and ID at the entrance.</li>
          <li>&rarr; Bring a Chinese phone number for the WeChat reservation flow at Gansu Provincial Museum.</li>
          <li>&rarr; Photography rules vary by glass case and hall; ask at the entrance desk before shooting.</li>
        </ul>
      </div>
    </div>
  </article>

  <RelatedLinks
    title="Continue exploring"
    links={[
      { href: "/mogao-caves/", label: "Mogao Caves guide" },
      { href: "/tickets/", label: "Ticket prices" },
      { href: "/guide/", label: "Complete travel guide" },
      { href: "/photography/", label: "Photography tips" },
      { href: "/food/", label: "Food in the corridor" },
    ]}
  />
  <NewsletterSignup />
</BaseLayout>