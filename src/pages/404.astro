---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Dunhuang &amp; Jiuquan Guide"
  description="The page you are looking for does not exist."
  noindex
>
  <div class="section-container py-32 text-center">
    <h1 class="text-6xl font-display font-bold text-mogao-600 mb-4">404</h1>
    <p class="text-xl text-stone-600 mb-8">Lost in the Gobi? This page doesn't exist.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="u-btn-solid2">Back to Home</a>
      <a href="/guide/" class="u-btn-ghost">Read the Guide</a>
    </div>
  </div>
</BaseLayout>
