---
interface Props {
  title: string;
  subtitle?: string;
  columns: { label: string; highlight?: boolean; image?: { src: string; alt: string; width: number; height: number } }[];
  rows: { dimension: string; values: string[] }[];
}

const { title, subtitle, columns, rows } = Astro.props;
---

<section class="py-16 md:py-20 bg-white">
  <div class="section-container">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-stone-900">
      {title}
    </h2>
    {subtitle && (
      <p class="mt-3 text-stone-500 max-w-2xl leading-relaxed">{subtitle}</p>
    )}
    <div class="mt-10 overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-stone-200">
            <th class="text-left py-3 pr-4 font-semibold text-stone-400 text-xs uppercase tracking-wider">
              {rows.length ? "Compare" : ""}
            </th>
            {columns.map((c) => (
              <th
                class={`text-left py-3 px-4 font-semibold text-xs uppercase tracking-wider ${
                  c.highlight ? "text-mogao-600" : "text-stone-400"
                }`}
              >
{c.image && (
                <img
                  src={c.image.src}
                  alt={c.image.alt}
                  width={c.image.width}
                  height={c.image.height}
                  loading="lazy"
                  decoding="async"
                  srcset={
                    c.image.src.includes("responsive")
                      ? undefined
                      : `${c.image.src.replace("/images/", "/images/responsive/").replace(".webp", "-480.webp")} 480w, ${c.image.src.replace("/images/", "/images/responsive/").replace(".webp", "-768.webp")} 768w`
                  }
                  sizes="96px"
                  class="w-16 h-12 rounded-lg object-cover border border-stone-200 mb-2"
                />
              )}
                {c.label}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-stone-100 hover:bg-stone-50/60 transition-colors">
              <td class="py-3.5 pr-4 align-top font-semibold text-stone-800 whitespace-nowrap">
                {r.dimension}
              </td>
              {r.values.map((v, i) => (
                <td class={`py-3.5 px-4 align-top text-stone-600 leading-relaxed ${columns[i]?.highlight ? "bg-mogao-50/40" : ""}`}>
                  {v}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>